generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RankingStatus {
  DRAFT
  PUBLISHED
}

enum AnimeStatus {
  AIRING
  FINISHED
  NOT_YET_RELEASED
}

enum AnimeFormat {
  TV
  TV_SHORT
  MOVIE
  SPECIAL
  OVA
  ONA
  MUSIC
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_WATCH
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique @db.VarChar(30)
  email        String  @unique @db.VarChar(255)
  passwordHash String
  avatarUrl    String? @db.Text
  bio          String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rankings      Ranking[]
  animeRatings  AnimeRating[]
  animeLists    UserAnime[]
  refreshTokens RefreshToken[]

  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Anime {
  id           String  @id @default(cuid())
  anilistId    Int?    @unique
  title        String  @db.VarChar(255)
  englishTitle String? @db.VarChar(255)
  description  String? @db.Text
  posterUrl    String? @db.Text
  bannerUrl    String? @db.Text

  format     AnimeFormat?
  status     AnimeStatus?
  episodes   Int?
  seasonYear Int?
  genres     String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings      AnimeRating[]
  rankingItems RankingItem[]
  userLists    UserAnime[]

  @@index([title])
  @@index([seasonYear])
}

model AnimeRating {
  id     String  @id @default(cuid())
  score  Int
  review String? @db.VarChar(2000)

  userId  String
  animeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([animeId, score])
  @@index([userId, updatedAt])
}

model Ranking {
  id          String        @id @default(cuid())
  title       String        @db.VarChar(100)
  description String?       @db.VarChar(2000)
  coverUrl    String?       @db.Text
  status      RankingStatus @default(DRAFT)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items RankingItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt])
  @@index([userId, updatedAt])
}

model RankingItem {
  id       String  @id @default(cuid())
  position Int
  score    Int?
  note     String? @db.VarChar(500)

  rankingId String
  animeId   String

  ranking Ranking @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rankingId, animeId])
  @@unique([rankingId, position])
  @@index([animeId])
}

model UserAnime {
  id              String      @id @default(cuid())
  status          WatchStatus @default(PLAN_TO_WATCH)
  episodesWatched Int         @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?

  userId  String
  animeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, animeId])
  @@index([userId, status])
}
